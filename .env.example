# All settings come from environment variables. No passwords, keys or cookies in Git.
# Copy to .env to change a value (docker compose reads it automatically).

# --- service (service/src/service/main.py) ---
# Address and port the service listens on (HOST/PORT). In Docker the container always uses 8000;
# PORT is the port published on your machine.
HOST=0.0.0.0
PORT=8000
# Path to the codefinder rules file. Unset = codefinder's own default (codefinder/config/codes.csv).
CODEFINDER_CONFIG=
# ONNX image model and its class names. Unset = service/models/.
MODEL_PATH=
NAMES_PATH=

# --- OCR (codefinder/src/codefinder/ocr.py) ---
# Tesseract language packs, for example deu or deu+eng.
OCR_LANG=deu
# Seconds allowed for one OCR pass.
OCR_TIMEOUT=10
# Full path to tesseract(.exe) when it is not on PATH (not needed in Docker).
TESSERACT_CMD=

# --- monitor (monitor/src/monitor/config.py) ---
# Port the dashboard is published on your machine (container always uses 8501).
MONITOR_PORT=8501
# Unset = the container's own defaults under /app/monitor (see monitor/.env.example for the
# fresh-checkout/non-Docker defaults, which are relative to the monitor folder instead).
MONITOR_DATA_DIR=
MONITOR_AGG_DIR=
MONITOR_OUT_DIR=
MONITOR_COUNTRY=
MONITOR_MEMORY_LIMIT=

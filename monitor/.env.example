# All settings come from environment variables. No passwords or keys in Git.
MONITOR_DATA_DIR=data          # folder with the daily per-platform zip files (TikTok x DE only - download these by hand, see README)
MONITOR_AGG_DIR=data/agg       # folder for the downloaded six-platform/27-country aggregates (monitor fetches these itself)
MONITOR_OUT_DIR=out            # folder for monthly_totals.parquet / .csv / scale_totals / answers.md
MONITOR_COUNTRY=DE             # keep decisions whose territorial_scope includes this country (used by the TikTok-DE pipeline only)
MONITOR_MEMORY_LIMIT=4GB       # DuckDB memory limit
